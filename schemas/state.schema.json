{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/babar-raza/repo-presenter/schemas/state.schema.json",
  "title": "repo-presenter implementation cursor (DERIVED)",
  "description": "Shape of project/state.yaml once taskcards exist. This file is NEVER hand-written once a card is in flight. `gatecli.py validate` asserts the committed copy equals a fresh rebuild. Adapted from foss-mcp's schemas/state.schema.json (2026-10-21): release_images dropped entirely (Docker-image bookkeeping, irrelevant to a README pipeline), project const changed, gate_id pattern made permissive to match this repo's own gate ids (P0_BOOTSTRAP, P1_VERTICAL_SLICE, ...) rather than foss-mcp's fixed G0-G5.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "generated_by", "generated_at",
               "current_gate", "accepted_gates", "cards", "execution_limits"],
  "properties": {
    "schema_version": { "const": 1 },
    "project": { "const": "repo-presenter" },
    "generated_by": { "const": "gatecli" },
    "generated_at": { "$ref": "#/$defs/timestamp" },
    "current_gate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/gate_id" },
        "status": { "enum": ["READY", "IN_PROGRESS", "VERIFYING", "ACCEPTED", "BLOCKED_EXTERNAL", "BLOCKED_ENV", "FAILED_INTERNAL", "EXIT_PENDING", "EXIT_FAILED"] }
      }
    },
    "gate_exit": {
      "oneOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false,
          "required": ["verdict", "checked_head", "recorded_at", "report", "blockers"],
          "properties": {
            "verdict": { "enum": ["MET", "NOT_MET", "BLOCKED_ENV"] },
            "checked_head": { "type": "string" },
            "recorded_at": { "type": "string" },
            "report": { "type": "string" },
            "blockers": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "accepted_gates": { "type": "array", "items": { "$ref": "#/$defs/gate_id" }, "uniqueItems": true },
    "cards": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "gate", "status", "attempt", "blocker"],
        "properties": {
          "id":      { "type": "string", "pattern": "^TC-[0-9]{3}[a-z]?$" },
          "gate":    { "$ref": "#/$defs/gate_id" },
          "status":  { "enum": ["PENDING", "READY", "IN_PROGRESS", "VERIFYING",
                                 "ACCEPTED", "SUPERSEDED", "FAILED_INTERNAL", "BLOCKED_EXTERNAL", "BLOCKED_ENV", "DEFERRED"] },
          "attempt": { "type": "integer", "minimum": 0, "maximum": 3 },
          "commit":  { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "receipt": { "type": "string", "minLength": 1 },
          "blocker": { "$ref": "#/$defs/blocker" }
        },
        "allOf": [{
          "if":   { "properties": { "status": { "enum": ["BLOCKED_EXTERNAL", "BLOCKED_ENV", "FAILED_INTERNAL"] } } },
          "then": { "properties": { "blocker": { "type": "object" } } },
          "else": { "properties": { "blocker": { "type": "null" } } }
        }]
      }
    },
    "execution_limits": {
      "type": "object", "additionalProperties": false,
      "required": ["workers_in_flight", "max_attempts_per_card", "supervisor_writes_product_code", "worker_issues_verdicts"],
      "properties": {
        "workers_in_flight": { "type": "integer", "minimum": 1, "maximum": 4 },
        "max_attempts_per_card": { "const": 3 },
        "supervisor_writes_product_code": { "const": false },
        "worker_issues_verdicts": { "const": false }
      }
    }
  },
  "$defs": {
    "text":      { "type": "string", "minLength": 1 },
    "gate_id":   { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "blocker": {
      "oneOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false,
          "required": ["class", "summary", "resume_predicate", "recorded_at"],
          "properties": {
            "class":   { "enum": ["BLOCKED_EXTERNAL", "BLOCKED_ENV", "FAILED_INTERNAL"] },
            "summary": { "$ref": "#/$defs/text" },
            "resume_predicate": { "$ref": "#/$defs/text" },
            "recorded_at": { "$ref": "#/$defs/timestamp" }
          }
        }
      ]
    }
  }
}
