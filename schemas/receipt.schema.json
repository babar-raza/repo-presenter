{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/babar-raza/repo-presenter/schemas/receipt.schema.json",
  "title": "repo-presenter verification receipt",
  "description": "evidence/build/<gate>/<card>/receipt.json. Written ONLY by `gatecli.py verify`. A receipt is a CACHE, not an authority. accepted is true only when the clean run passed twice identically AND the negative-control run failed. Adapted from foss-mcp's schemas/receipt.schema.json (2026-10-21): the container-runner fingerprint field and the pinned-venv lock_sha256 are dropped for v1 since this repository has no requirements.lock or container runner yet; fingerprint is simplified to python version + platform only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "card", "gate", "generated_by", "generated_at",
    "base_rev", "head_rev", "fingerprint", "scope", "runs",
    "negative_control", "accepted"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "card": { "type": "string", "pattern": "^TC-[0-9]{3}[a-z]?$" },
    "gate": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "generated_by": { "const": "gatecli" },
    "generated_at": { "$ref": "#/$defs/timestamp" },
    "base_rev": { "$ref": "#/$defs/sha40" },
    "head_rev": { "$ref": "#/$defs/sha40" },
    "card_sha256": { "$ref": "#/$defs/sha256" },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "platform"],
      "properties": {
        "python": { "$ref": "#/$defs/text" },
        "platform": { "$ref": "#/$defs/text" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "changed_paths", "violations"],
      "properties": {
        "ok": { "type": "boolean" },
        "changed_paths": { "type": "array", "items": { "type": "string" } },
        "violations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "runs": {
      "description": "The clean check set, executed TWICE. Disagreement between run 1 and run 2 is a flake and fails the card.",
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run", "checks", "all_passed"],
        "properties": {
          "run": { "type": "integer", "minimum": 1, "maximum": 2 },
          "all_passed": { "type": "boolean" },
          "checks": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["command", "exit_code", "duration_s", "stdout_sha256"],
              "properties": {
                "command": { "$ref": "#/$defs/text" },
                "exit_code": { "type": "integer" },
                "duration_s": { "type": "number", "minimum": 0 },
                "stdout_sha256": { "$ref": "#/$defs/sha256" },
                "tests": { "type": "integer", "minimum": 0 },
                "skipped": { "type": "integer", "minimum": 0 },
                "errors": { "type": "integer", "minimum": 0 },
                "failures": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "negative_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "patch", "patch_sha256", "applied", "patch_applied_failed"],
      "properties": {
        "patch": { "type": "string", "minLength": 1 },
        "patch_sha256": { "$ref": "#/$defs/sha256" },
        "applied": { "type": "boolean" },
        "patch_applied_failed": { "type": "boolean" },
        "exit_codes": { "type": "array", "items": { "type": "integer" } },
        "kind": { "enum": ["patch", "mutate"] },
        "tree_changed": { "type": "array", "items": { "type": "string" } }
      }
    },
    "accepted": { "type": "boolean" },
    "reason": { "type": "string" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "sha40": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
  }
}
