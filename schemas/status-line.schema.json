{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/babar-raza/repo-presenter/schemas/status-line.schema.json",
  "title": "repo-presenter worker status line",
  "description": "One line of ops/status.jsonl. Appended ONLY via `gatecli.py status-append`, which fills ts and commit itself. No model ever types these two fields. Ported near-verbatim from foss-mcp's schemas/status-line.schema.json (2026-10-21) -- no foss-mcp-specific content.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ts", "card", "phase", "verdict", "summary", "commit", "attempt"],
  "properties": {
    "ts":      { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "card":    { "type": "string", "pattern": "^(TC-[0-9]{3}[a-z]?|SESSION)$" },
    "phase":   { "enum": ["started", "committed", "blocked", "new_defect", "provisional", "ended"] },
    "verdict": { "enum": ["pass", "fail", "n/a"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "commit":  { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 3 },
    "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
