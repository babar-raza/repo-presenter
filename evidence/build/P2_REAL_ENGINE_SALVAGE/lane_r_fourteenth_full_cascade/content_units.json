      "section": "scope_limitations",
      "slot": "scope",
      "text": "Aspose.Slides FOSS for Python reads and writes OOXML presentation formats, including PPTX, PPTM, PPSX, PPSM, POTX, and POTM, and supports Markdown export via SaveFormat.MD; it does not render or convert to PDF, HTML, XPS, or image formats, nor does it support layout, rasterization, or non-OOXML save paths beyond those two families."
    },
    {
      "fact_ids": [
        "identity:repository",
        "inherited_unit:115.list",
        "package:license",
        "package:name",
        "package:python_requires",
        "package:version",
        "public_symbol:slides_foss.export.saveformat"
      ],
      "section": "scope_limitations",
      "slot": "limitation:1",
      "text": "Rendering and conversion of any kind is not implemented, so PDF, HTML, XPS, and image export are unavailable."
    },
    {
      "fact_ids": [
        "identity:repository",
        "inherited_unit:115.list",
