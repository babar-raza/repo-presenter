        "public_symbol:slides_foss.export.saveformat"
      ],
      "section": "scope_limitations",
      "slot": "limitation:2",
      "text": "SmartArt, OLE objects, and mathematical text are not yet implemented and raise NotImplementedError."
    },
    {
