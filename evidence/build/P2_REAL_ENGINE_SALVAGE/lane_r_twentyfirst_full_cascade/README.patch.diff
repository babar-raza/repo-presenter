-
-namespace ann = Aspose::Pdf::Annotations;
-ann::HighlightAnnotation a(page, pdf::Rectangle(60, 700, 210, 716, true));  // keep alive until Save()
-a.Color(pdf::Color::FromRgb(1.0, 0.95, 0.0));
