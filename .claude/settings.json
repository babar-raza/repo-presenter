{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git checkout *)",
      "Bash(git branch*)",
      "Bash(git stash*)",
      "Bash(git worktree*)",
      "Bash(git remote*)",
      "Bash(git for-each-ref*)",
      "Bash(git merge-base*)",
      "Bash(git apply*)",
      "Bash(git revert*)",
      "Bash(git reset --soft*)",
      "Bash(git reset --mixed*)",
      "Bash(git reset HEAD*)",
      "Bash(python ops/gatecli.py *)",
      "Bash(python ops/checks/*)",
      "Bash(python ops/gatectl.py *)",
      "Bash(python ops/gateverify.py *)",
      "Bash(python -m pytest*)",
      "Bash(python scripts/*)",
      "Bash(python -m repo_presenter.*)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr close*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr comment*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh run watch*)",
      "Bash(gh run rerun*)",
      "Bash(gh api *)",
      "Bash(gh repo view*)",
      "Bash(gh workflow list*)",
      "Bash(gh workflow view*)",
      "Bash(gh workflow run*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --delete*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)",
      "Bash(git branch --delete --force*)",
      "Bash(git tag -d*)",
      "Bash(git filter-branch*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo archive*)",
      "Bash(gh api -X DELETE*)",
      "Bash(gh api --method DELETE*)",
      "Bash(gh pr merge*)",
      "Bash(gh secret*)",
      "Bash(gh auth*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$CLAUDE_PROJECT_DIR/docs/RULINGS.md\""
          }
        ]
      }
    ]
  }
}
