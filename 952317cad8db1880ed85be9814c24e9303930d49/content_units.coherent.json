      ],
      "section": "key_capabilities",
      "slot": "capability:4",
      "text": "It exports workbooks to .csv, .tsv, .json, .markdown, .md, and .pdf formats using Workbook.save() with format inferred from extension or PdfSaveOptions for PDF."
    },
    {
      "fact_ids": [
        "example:006",
