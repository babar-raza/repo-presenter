+
+row := table.AddRow()
+row.AddCells("Widget", "Standard widget", "5")
+
+pagesAdded, _ := page.AddTable(table, pdf.Rectangle{LLX: 50, LLY: 600, URX: 545, URY: 750})
+fmt.Printf("table flowed to %d additional pages\n", pagesAdded)
+doc.Save("table.pdf")
+```
