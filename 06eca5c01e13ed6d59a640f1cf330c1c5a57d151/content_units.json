        "public_symbol:aspose_barcode_foss.ean13",
        "public_symbol:aspose_barcode_foss.ean8",
        "public_symbol:aspose_barcode_foss.qr",
        "public_symbol:aspose_barcode_foss.upca",
        "public_symbol:aspose_barcode_foss.upce"
      ],
      "section": "key_capabilities",
      "slot": "capability:1",
      "text": "It generates barcodes using Code 128, Code 39, EAN-13, EAN-8, UPC-A, UPC-E, and QR Code symbologies, each accessible through dedicated factory functions."
    },
    {
