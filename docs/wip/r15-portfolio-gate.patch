+++ b/src/repo_presenter/propose/portfolio_gate.py
@@ -0,0 +1,65 @@
+"""Owner ruling R15 (2026-11-06): no upstream push before every candidate of both lanes is sealed, validated
+and passed.
+
+"Every candidate" is every ACTIVE repository of ``data/registry.json``, in BOTH Lane R and Lane L: each must
+have a latest seal that re-certifies under the current code (``recertify.portfolio_recertification``, zero
+provider calls). Upstream PR creation (``propose/effect.py``) refuses with ``Refusal.PORTFOLIO_INCOMPLETE``
+until this holds; independent acceptance (reviewer/acceptance calibration) is a separate gate that must hold too.
+Computed from the state remote's seal history every time -- never read from an editable record.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable, Iterable
+from dataclasses import dataclass
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parents[3]
+LANES = ("R", "L")
+
+
+@dataclass(frozen=True)
+class PortfolioReadiness:
+    ready: bool
+    active: int
+    missing: tuple[tuple[str, str], ...]  # (repository, lane) not yet sealed + passing
+
+    def reason(self) -> str:
+        if self.ready:
+            return f"all {self.active} active repositories are sealed and pass in both lanes"
+        shown = ", ".join(f"{repo} lane {lane}" for repo, lane in self.missing[:8])
+        more = f" (and {len(self.missing) - 8} more)" if len(self.missing) > 8 else ""
+        return (
+            f"owner ruling R15: no upstream push before every candidate of both lanes is sealed, "
+            f"validated and passed; {len(self.missing)} of {2 * self.active} (repository, lane) "
+            f"candidates are not yet: {shown}{more}"
+        )
+
+
+def readiness_from(
+    active: Iterable[str], certified: Iterable[tuple[str, str]]
+) -> PortfolioReadiness:
+    """Pure: ``active`` repositories, ``certified`` (repository, lane) pairs that pass."""
+    repos = sorted(set(active))
+    passing = set(certified)
+    missing = tuple((repo, lane) for repo in repos for lane in LANES if (repo, lane) not in passing)
+    return PortfolioReadiness(ready=not missing and bool(repos), active=len(repos), missing=missing)
+
+
+def portfolio_readiness(
+    *,
+    remote: str = "origin",
+    registry: Path = REPO_ROOT / "data" / "registry.json",
+    prompts_dir: Path = REPO_ROOT / "prompts",
+) -> PortfolioReadiness:
+    """Read-only, zero provider calls: re-certify every latest seal and compare with the registry."""
+    from repo_presenter.core.registry.loader import load_registry
+    from repo_presenter.recertify import OUTCOME_RECERTIFIED, portfolio_recertification
+
+    active = [entry.repository for entry in load_registry(registry).entries if entry.active]
+    results, _ = portfolio_recertification(remote=remote, registry=registry, prompts_dir=prompts_dir)
+    certified = [(r.repository, r.lane) for r in results if r.outcome == OUTCOME_RECERTIFIED]
+    return readiness_from(active, certified)
+
+
+ReadinessFn = Callable[[], PortfolioReadiness]
