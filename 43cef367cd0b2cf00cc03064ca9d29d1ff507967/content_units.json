      "slot": "hub:public_symbol:aspose.page.xps",
      "text": "The aspose.page.xps module enables working with XML Paper Specification (.xps) documents through classes like XpsDocument, XpsDocumentBuilder, and XpsCanvas, supporting document loading, editing, and conversion to PDF or raster images."
    },
